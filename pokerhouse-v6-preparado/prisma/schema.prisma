generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DemoTransactionType {
  GRANT_DEMO
  DAILY_REWARD
  TABLE_BUY_IN
  TABLE_CASH_OUT
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  ADJUSTMENT
}

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id           String                   @id @default(cuid())
  email        String                   @unique
  username     String                   @unique
  passwordHash String
  role         UserRole                 @default(PLAYER)
  status       UserStatus               @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  wallet       DemoWallet?
  transactions DemoChipTransaction[]
  registrations TournamentRegistration[]
  inventory    InventoryItem[]
  courseAccess CourseEntitlement[]
  courseProgress CourseProgress[]
  coursePayments CoursePayment[]
  financialAccounts FinancialWalletAccount[]
}

model DemoWallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance BigInt @default(10000)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DemoChipTransaction {
  id          String               @id @default(cuid())
  userId      String
  type        DemoTransactionType
  amount      BigInt
  referenceId String?
  description String
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PokerTable {
  id         String   @id @default(cuid())
  name       String
  smallBlind Int      @default(10)
  bigBlind   Int      @default(20)
  buyIn      Int      @default(500)
  maxPlayers Int      @default(6)
  status     String   @default("WAITING")
  createdAt  DateTime @default(now())
}

model Tournament {
  id            String                   @id @default(cuid())
  name          String
  entryChips    Int                      @default(0)
  maxPlayers    Int                      @default(18)
  startsAt      DateTime
  status        String                   @default("SCHEDULED")
  registrations TournamentRegistration[]
}

model TournamentRegistration {
  id           String     @id @default(cuid())
  userId       String
  tournamentId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

model StoreItem {
  id          String          @id @default(cuid())
  name        String
  description String
  rarity      String
  priceChips  Int
  imageKey    String          @default("sparkle")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  inventory   InventoryItem[]
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  acquiredAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model PokerGameSnapshot {
  id        String   @id @default(cuid())
  tableId   String   @unique
  state     Json
  updatedAt DateTime @updatedAt
}


// Poker House Academy: no real-money transactions are processed by this schema alone.
model Course {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @default("")
  published   Boolean @default(false)
  createdAt   DateTime @default(now())
  modules     CourseModule[]
  entitlements CourseEntitlement[]
}
model CourseModule {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int @default(0)
  course   Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  lessons  CourseLesson[]
  @@index([courseId,position])
}
model CourseLesson {
  id        String @id @default(cuid())
  moduleId  String
  title     String
  position  Int @default(0)
  pdfUrl    String?
  videoUrl  String?
  module    CourseModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
  progress  CourseProgress[]
  @@index([moduleId,position])
}
model CourseEntitlement {
  id        String @id @default(cuid())
  userId    String
  courseId  String
  grantedAt DateTime @default(now())
  sourcePaymentId String? @unique
  user      User @relation(fields:[userId],references:[id],onDelete:Cascade)
  course    Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  @@unique([userId,courseId])
}
model CourseProgress {
  id          String @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User @relation(fields:[userId],references:[id],onDelete:Cascade)
  lesson      CourseLesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
  @@unique([userId,lessonId])
}
model CoursePayment {
  id          String @id @default(cuid())
  userId      String
  provider    String
  providerPaymentId String @unique
  amountCents Int
  currency    String @default("BRL")
  status      String @default("PENDING")
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  user        User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,status])
}


// Future USD-only financial ledger. No payment provider is connected by this schema.
// Real-money flows remain disabled until legal and provider approval.
model FinancialWalletAccount {
  id          String   @id @default(cuid())
  userId      String
  currency    String   @default("USD")
  accountType String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries     FinancialLedgerEntry[]

  @@unique([userId, currency, accountType])
  @@index([userId, status])
}

model FinancialLedgerTransaction {
  id                String   @id @default(cuid())
  type              String
  status            String   @default("DRAFT")
  idempotencyKey    String   @unique
  externalReference String?  @unique
  description       String
  createdAt         DateTime @default(now())
  postedAt          DateTime?
  entries           FinancialLedgerEntry[]

  @@index([status, createdAt])
}

model FinancialLedgerEntry {
  id            String   @id @default(cuid())
  transactionId String
  accountId     String
  direction     String
  amountMinor   BigInt
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  transaction   FinancialLedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account       FinancialWalletAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
}
