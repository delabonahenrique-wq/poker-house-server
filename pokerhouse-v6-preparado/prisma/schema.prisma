generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DemoTransactionType {
  GRANT_DEMO
  DAILY_REWARD
  TABLE_BUY_IN
  TABLE_CASH_OUT
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  ADJUSTMENT
}

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id           String                   @id @default(cuid())
  email        String                   @unique
  username     String                   @unique
  passwordHash String
  role         UserRole                 @default(PLAYER)
  status       UserStatus               @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  wallet       DemoWallet?
  transactions DemoChipTransaction[]
  registrations TournamentRegistration[]
  inventory    InventoryItem[]
  courseAccess CourseEntitlement[]
  courseProgress CourseProgress[]
  coursePayments CoursePayment[]
  empireWallet EmpireWallet?
  empireLedger EmpireLedger[]
  handRewards WorldHandReward[]
  casinos Casino[]
  casinoStaff CasinoStaff[]
  empireAssets EmpireAsset[]
  marketListings MarketListing[]
}

model DemoWallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance BigInt @default(10000)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DemoChipTransaction {
  id          String               @id @default(cuid())
  userId      String
  type        DemoTransactionType
  amount      BigInt
  referenceId String?
  description String
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PokerTable {
  id         String   @id @default(cuid())
  name       String
  smallBlind Int      @default(10)
  bigBlind   Int      @default(20)
  buyIn      Int      @default(500)
  maxPlayers Int      @default(6)
  status     String   @default("WAITING")
  createdAt  DateTime @default(now())
}

model Tournament {
  id            String                   @id @default(cuid())
  name          String
  entryChips    Int                      @default(0)
  maxPlayers    Int                      @default(18)
  startsAt      DateTime
  status        String                   @default("SCHEDULED")
  registrations TournamentRegistration[]
}

model TournamentRegistration {
  id           String     @id @default(cuid())
  userId       String
  tournamentId String
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

model StoreItem {
  id          String          @id @default(cuid())
  name        String
  description String
  rarity      String
  priceChips  Int
  imageKey    String          @default("sparkle")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  inventory   InventoryItem[]
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  acquiredAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model PokerGameSnapshot {
  id        String   @id @default(cuid())
  tableId   String   @unique
  state     Json
  updatedAt DateTime @updatedAt
}


// Poker House Academy: no real-money transactions are processed by this schema alone.
model Course {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String @default("")
  published   Boolean @default(false)
  createdAt   DateTime @default(now())
  modules     CourseModule[]
  entitlements CourseEntitlement[]
}
model CourseModule {
  id       String @id @default(cuid())
  courseId String
  title    String
  position Int @default(0)
  course   Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  lessons  CourseLesson[]
  @@index([courseId,position])
}
model CourseLesson {
  id        String @id @default(cuid())
  moduleId  String
  title     String
  position  Int @default(0)
  pdfUrl    String?
  videoUrl  String?
  module    CourseModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
  progress  CourseProgress[]
  @@index([moduleId,position])
}
model CourseEntitlement {
  id        String @id @default(cuid())
  userId    String
  courseId  String
  grantedAt DateTime @default(now())
  sourcePaymentId String? @unique
  user      User @relation(fields:[userId],references:[id],onDelete:Cascade)
  course    Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  @@unique([userId,courseId])
}
model CourseProgress {
  id          String @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User @relation(fields:[userId],references:[id],onDelete:Cascade)
  lesson      CourseLesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
  @@unique([userId,lessonId])
}
model CoursePayment {
  id          String @id @default(cuid())
  userId      String
  provider    String
  providerPaymentId String @unique
  amountCents Int
  currency    String @default("BRL")
  status      String @default("PENDING")
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  user        User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,status])
}


enum EmpireLedgerType {
  HAND_WIN
  LAND_PURCHASE
  BUILD
  STAFF_HIRE
  STAFF_TRAINING
  MARKETING
  MARKET_PURCHASE
  OPERATING_COST
  SIMULATED_REVENUE
}

model EmpireWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmpireLedger {
  id          String           @id @default(cuid())
  userId      String
  type        EmpireLedgerType
  amount      BigInt
  referenceId String?
  description String
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([referenceId])
}

model WorldHandReward {
  id        String   @id @default(cuid())
  userId    String
  handRef   String
  amount    BigInt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, handRef])
  @@index([handRef])
}

model Casino {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  theme       String   @default("royal")
  primaryColor String @default("#B88A35")
  secondaryColor String @default("#171717")
  reputation  Int      @default(50)
  level       Int      @default(1)
  totalVisitors Int    @default(0)
  reviewAverage Float  @default(0)
  reviewCount Int      @default(0)
  monthlyRevenue BigInt @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staff       CasinoStaff[]
  assets      EmpireAsset[]
  @@index([ownerId, createdAt])
}

model CasinoStaff {
  id          String   @id @default(cuid())
  casinoId    String
  ownerId     String
  role        String
  skill       Int      @default(1)
  experience  Int      @default(0)
  salary      BigInt   @default(0)
  createdAt   DateTime @default(now())
  casino      Casino   @relation(fields: [casinoId], references: [id], onDelete: Cascade)
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([casinoId])
  @@index([ownerId])
}

model EmpireAsset {
  id          String   @id @default(cuid())
  ownerId     String
  casinoId    String?
  kind        String
  name        String
  level       Int      @default(1)
  purchaseCost BigInt  @default(0)
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  casino      Casino?  @relation(fields: [casinoId], references: [id], onDelete: SetNull)
  marketListing MarketListing?
  @@index([ownerId, kind])
}

model MarketListing {
  id          String   @id @default(cuid())
  ownerId     String
  assetId     String   @unique
  price       BigInt
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  asset       EmpireAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}
